# Chave AES-256 (64 caracteres hexadecimais) para criptografar senhas Oracle e assinar cookies de sessão
# Gere uma chave segura em produção com: openssl rand -hex 32
ENCRYPTION_KEY=

# Senha inicial aplicada ao usuário 'admin' apenas na primeira inicialização (se data/users.json não existir)
DEFAULT_ADMIN_PASSWORD=admin123

# Caminho opcional do Oracle Instant Client (no Docker já aponta para /opt/oracle/instantclient)
# ORACLE_CLIENT_PATH=/opt/oracle/instantclient
